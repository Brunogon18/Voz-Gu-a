{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "tsc: compilar tests",
      "type": "shell",
      "command": "npx tsc -p tsconfig.test.json",
      "problemMatcher": ["$tsc"],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "npm: typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": ["$tsc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "npm: lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": []
    }
  ]
}
