{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "dist-tests",
    "rootDir": "."
  },
  "include": [
    "src/types/**/*.ts",
    "src/data/**/*.ts",
    "src/services/vectorSearch.ts",
    "src/services/meshRouter.ts",
    "src/services/geminiService.ts",
    "src/services/speechUtils.ts",
    "src/services/webTramiteService.ts",
    "tests/**/*.ts"
  ]
}
