# Opcional: API Key de Google AI Studio (Gemini 3.5 Flash-Lite / 3.8 Flash).
# Si no se define, Voz Guía funciona 100% offline con SQLite vectorial y guías locales.
# Para producción, mueve esta llave a un backend proxy y nunca la subas al repositorio.
EXPO_PUBLIC_GEMINI_API_KEY=

# Opcional: URL del Relay Mesh local (npm run mesh:relay) para pruebas entre 2 celulares en Expo Go.
# Ejemplo: http://192.168.1.50:8787
EXPO_PUBLIC_MESH_RELAY_URL=
